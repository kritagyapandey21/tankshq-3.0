# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Telethon StringSession for the Telegram user account that can message AffiliatePocketBot.
# Create one with:  python make_telegram_session.py   (keep it secret, never commit it)
TELEGRAM_SESSION_STRING=create_with_make_telegram_session.py

# Block login when Telegram verification is unavailable or not configured
REQUIRE_VERIFICATION=true

# Optional: exactly one Trader ID may bypass Telegram verification.
# Keep this value private and do not commit it.
# BYPASS_TRADER_ID=TR12345

# Optional local API protection
# ADMIN_KEY=replace_with_a_long_random_value

# Pocket Option session for live signals/chart (from a logged-in browser). Keep secret.
# LO_UID=

# Daily "time to trade" notification (optional)
# NOTIFY_TIME=10:00
# NOTIFY_TZ=Asia/Kolkata
# VAPID_SUBJECT=mailto:you@yourdomain.com

# Signal engine: v2 (original, default) | v3 | v3-reversion | v3-reversion-plus
# SIGNAL_ENGINE=v2
